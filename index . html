<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Turb Carrossel</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@700;800;900&family=Inter:wght@400;500;600&family=Montserrat:wght@700;800;900&family=Poppins:wght@700;800;900&family=Open+Sans:wght@700;800&family=Bebas+Neue&family=Anton&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="https://unpkg.com/jszip@3.10.1/dist/jszip.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#000000;color:#F4F6FC;font-family:'Inter',system-ui,sans-serif;height:100vh;overflow:hidden;display:flex}

/* ── Icon rail ── */
#rail{width:64px;height:100vh;background:#000000;border-right:1px solid #1e1e30;display:flex;flex-direction:column;align-items:center;padding:16px 0;gap:4px;flex-shrink:0;z-index:20}
.rail-logo{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#FF6229,#FFCC47);display:flex;align-items:center;justify-content:center;margin-bottom:16px;flex-shrink:0}
.rail-btn{width:40px;height:40px;border-radius:10px;border:none;background:transparent;color:#555;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;position:relative;flex-shrink:0}
.rail-btn:hover{background:#1e1e30;color:#aaa}
.rail-btn.on{background:#FF622918;color:#FF6229}
.rail-btn .tooltip{position:absolute;left:52px;background:#1e1e30;color:#F4F6FC;font-size:11px;font-weight:500;padding:4px 10px;border-radius:6px;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .15s;z-index:100;border:1px solid #2e2e42}
.rail-btn:hover .tooltip{opacity:1}
.rail-sep{width:28px;height:1px;background:#1e1e30;margin:6px 0;flex-shrink:0}

/* ── Sidebar panel ── */
#sidebar{width:0;height:100vh;background:#000000;border-right:1px solid #1e1e30;overflow:hidden;transition:width .25s cubic-bezier(.4,0,.2,1);flex-shrink:0;z-index:10;display:flex;flex-direction:column}
#sidebar.open{width:300px}
#sidebar-inner{width:300px;height:100%;display:flex;flex-direction:column;overflow:hidden}
.sb-header{padding:20px 20px 14px;border-bottom:1px solid #1e1e30;flex-shrink:0}
.sb-title{font-family:'Sora',system-ui;font-weight:800;font-size:13px;color:#F4F6FC;letter-spacing:-.01em}
.sb-sub{font-size:11px;color:#555;margin-top:2px}
.sb-body{flex:1;overflow-y:auto;padding:14px 16px;scrollbar-width:thin;scrollbar-color:#2e2e42 transparent}
.sb-body::-webkit-scrollbar{width:3px}
.sb-body::-webkit-scrollbar-thumb{background:#2e2e42;border-radius:2px}

.sb-section{margin-bottom:6px;border-radius:12px;overflow:hidden;border:1px solid #1e1e30}
.sb-section-hd{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;cursor:pointer;background:#000000;transition:background .15s;user-select:none}
.sb-section-hd:hover{background:#1e1e32}
.sb-section-lbl{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#FF6229}
.sb-section-body{background:#000000;padding:14px}
.sb-section-body.hidden{display:none}

.flbl{font-size:11px;color:#666;font-weight:500;margin-bottom:5px;display:block}
.field{width:100%;background:#1e1e30;border:1px solid #252540;border-radius:9px;padding:9px 12px;color:#F4F6FC;font-size:12px;outline:none;font-family:inherit;resize:none;transition:border-color .15s}
.field:focus{border-color:#FF6229}
.field::placeholder{color:#333}
.sel{width:100%;background:#1e1e30;border:1px solid #252540;border-radius:7px;padding:6px 9px;color:#F4F6FC;font-size:11px;outline:none;cursor:pointer;font-family:inherit}
.range{width:100%;accent-color:#FF6229;cursor:pointer}
.pill{padding:5px 11px;border-radius:100px;font-size:10px;font-weight:500;border:1px solid #252540;background:#1e1e30;color:#555;cursor:pointer;transition:all .15s;white-space:nowrap;font-family:inherit}
.pill:hover{color:#aaa;border-color:#FF622944}
.pill.on{background:#FF6229;border-color:#FF6229;color:#000000;font-weight:700}
.cnt-btn{width:30px;height:30px;background:#1e1e30;border:1px solid #252540;border-radius:6px;color:#555;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit;transition:all .12s}
.cnt-btn:hover{color:#aaa;border-color:#FF622944}
.cnt-btn.on{background:#FF6229;border-color:#FF6229;color:#000000}
.small-btn{width:22px;height:22px;border-radius:5px;background:#1e1e30;border:1px solid #252540;color:#666;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;font-family:inherit}
.slide-tab{padding:6px 12px;border-radius:7px;font-size:10px;font-weight:600;border:1px solid #252540;background:#1e1e30;color:#555;cursor:pointer;white-space:nowrap;font-family:inherit;transition:all .12s}
.slide-tab.on{background:#FF622918;border-color:#FF622944;color:#FF6229}
.ai-badge{display:inline-flex;align-items:center;gap:3px;padding:2px 6px;border-radius:100px;font-size:9px;font-weight:700;background:#FF622918;border:1px solid #FF622944;color:#FF6229}

/* Buttons */
.btn-main{width:100%;padding:11px;border-radius:10px;background:linear-gradient(135deg,#FF6229,#FFCC47);color:#000000;font-weight:800;font-size:12px;border:none;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:7px;font-family:inherit}
.btn-main:hover:not(:disabled){filter:brightness(1.08);transform:translateY(-1px)}
.btn-main:disabled{opacity:.4;cursor:not-allowed;transform:none}
.btn-out{padding:8px 14px;border-radius:8px;background:transparent;border:1px solid #FF6229;color:#FF6229;font-weight:700;font-size:11px;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:5px;font-family:inherit}
.btn-out:hover:not(:disabled){background:#FF6229;color:#000000}
.btn-out:disabled{opacity:.4;cursor:not-allowed}
.btn-acc{padding:8px 14px;border-radius:8px;background:linear-gradient(135deg,#FF6229,#FFCC47);color:#000000;font-weight:700;font-size:11px;border:none;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:5px}
.btn-acc:hover:not(:disabled){filter:brightness(1.1)}
.btn-acc:disabled{opacity:.4;cursor:not-allowed}

/* ── Main canvas area ── */
#main{flex:1;height:100vh;overflow-y:auto;display:flex;flex-direction:column;background:#000000}
#topbar{height:52px;border-bottom:1px solid #1e1e30;display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex-shrink:0;background:#000000}
#topbar-left{display:flex;align-items:center;gap:12px}
#topbar-title{font-family:'Sora',system-ui;font-weight:900;font-size:16px}
#topbar-title span{background:linear-gradient(135deg,#FF6229,#FFCC47);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
#topbar-right{display:flex;gap:8px;align-items:center}
#canvas-area{flex:1;display:flex;align-items:center;justify-content:center;padding:32px;overflow:hidden}

/* Preview carousel */
#preview-wrap{display:flex;flex-direction:column;align-items:center;gap:20px;width:100%}
.track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 0;scrollbar-width:none;max-width:100%}
.track::-webkit-scrollbar{display:none}
.sw{scroll-snap-align:center;flex-shrink:0;transition:transform .3s,opacity .3s}
.sw.dim{transform:scale(.88);opacity:.35;cursor:pointer}
.insta{width:320px;height:427px;position:relative;overflow:hidden;border-radius:12px}
.progress-bar{height:3px;background:linear-gradient(90deg,#FF6229,#FFCC47);border-radius:2px;transition:width .3s}

@keyframes spin{to{transform:rotate(360deg)}}
.spin{animation:spin .9s linear infinite;display:inline-block}
@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.fadein{animation:fadein .3s ease}

/* Empty state */
#empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;opacity:.5;pointer-events:none}
</style>
</head>
<body>

<!-- ── Icon Rail ── -->
<div id="rail">
  <div class="rail-logo">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="6" stroke="white" stroke-width="2" fill="none"/><circle cx="12" cy="12" r="4.5" stroke="white" stroke-width="2" fill="none"/><circle cx="17.5" cy="6.5" r="1.2" fill="white"/></svg>
  </div>

  <button class="rail-btn" onclick="openPanel('ia')" id="rail-ia" title="">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/><circle cx="19" cy="5" r="3" fill="currentColor" stroke="none" opacity=".6"/></svg>
    <span class="tooltip">Gerar com IA</span>
  </button>

  <button class="rail-btn" onclick="openPanel('slides')" id="rail-slides">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
    <span class="tooltip">Slides</span>
  </button>

  <button class="rail-btn" onclick="openPanel('typo')" id="rail-typo">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
    <span class="tooltip">Tipografia</span>
  </button>

  <button class="rail-btn" onclick="openPanel('profile')" id="rail-profile">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
    <span class="tooltip">Perfil</span>
  </button>

  <div class="rail-sep"></div>

  <button class="rail-btn" onclick="openPanel('export')" id="rail-export">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    <span class="tooltip">Exportar</span>
  </button>
</div>

<!-- ── Sidebar ── -->
<div id="sidebar">
  <div id="sidebar-inner">
    <div class="sb-header">
      <div class="sb-title" id="sb-title">Gerar com IA</div>
      <div class="sb-sub" id="sb-sub">Crie slides com inteligência artificial</div>
    </div>
    <div class="sb-body" id="sb-body"></div>
  </div>
</div>

<!-- ── Main ── -->
<div id="main">
  <div id="topbar">
    <div id="topbar-left">
      <div style="font-family:'Sora',system-ui;font-weight:900;font-size:17px;letter-spacing:-.02em">
        Turb <span style="background:linear-gradient(135deg,#FF6229,#FFCC47);-webkit-background-clip:text;-webkit-text-fill-color:transparent">Carrossel</span>
      </div>
    </div>
    <div id="topbar-right">
      <button class="btn-out" onclick="openPanel('ia');document.getElementById('gen-btn')&&document.getElementById('gen-btn').click()" style="font-size:11px">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        Gerar com IA
      </button>
      <button class="btn-acc" onclick="dlAll()" id="topbar-dl">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Baixar todos
      </button>
    </div>
  </div>

  <div id="canvas-area">
    <div id="preview-wrap">
      <div id="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#FF6229" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <p style="font-size:14px;color:#555;text-align:center">Configure os slides no painel lateral<br>e clique em <b style="color:#FF6229">Gerar com IA</b></p>
      </div>
      <div id="pv-nav" style="display:none;flex-direction:column;align-items:center;gap:16px;width:100%">
        <div style="display:flex;align-items:center;gap:12px">
          <button onclick="pvNav(-1)" id="pv-prev" style="width:36px;height:36px;border-radius:50%;background:#000000;border:1px solid #2e2e42;color:#9090b0;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit">◀</button>
          <span id="pv-counter" style="font-size:12px;color:#555;min-width:50px;text-align:center">1 / 5</span>
          <button onclick="pvNav(1)" id="pv-next" style="width:36px;height:36px;border-radius:50%;background:#000000;border:1px solid #2e2e42;color:#9090b0;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit">▶</button>
        </div>
        <div id="pv-track" class="track"></div>
        <div id="pv-dots" style="display:flex;gap:5px"></div>
        <div id="pv-progress-wrap" style="display:none;width:320px">
          <div style="height:3px;background:#1e1e30;border-radius:2px"><div id="pv-bar" class="progress-bar" style="width:0%"></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const TONES=['Educativo','Comparativo','Análise de tendências','Dúp','Case de sucesso','Lista','Provocativo','Storytelling'];
const LOADING=['Analisando o tema…','Criando headlines…','Estruturando a narrativa…','Revisando o fluxo…','Finalizando…','Quase pronto…'];
const FONTS_H=['Sora','Montserrat','Poppins','Open Sans','Bebas Neue','Anton','Oswald','Arial'];
const FONTS_B=['Inter','Montserrat','Poppins','Open Sans','Oswald','Arial'];
const PANELS={
  ia:{title:'Gerar com IA',sub:'Crie slides com inteligência artificial'},
  slides:{title:'Slides',sub:'Edite o conteúdo de cada slide'},
  typo:{title:'Tipografia',sub:'Fontes, tamanhos e cores globais'},
  profile:{title:'Perfil',sub:'Seu @ e avatar do Instagram'},
  export:{title:'Exportar',sub:'Baixe seus slides em PNG ou ZIP'},
};

let selTone='', slideCount=5, loadTimer=null, pvIdx=0, currentPanel=null;
let slides=Array.from({length:10},makeSlide);
let profileData={username:'',avatar:null};

function makeSlide(){
  return{id:Math.random().toString(36).slice(2),headline:'',body:'',image:null,aiGenerated:false,
    hFont:'Sora',bFont:'Inter',hSize:26,bSize:14,hAlign:'center',bAlign:'left',
    hColor:'#F4F6FC',bColor:'rgba(244,246,252,0.7)',bg:'dark',
    imgX:50,imgY:50,imgOpacity:35,imgFit:'cover',hY:0,bY:0,cta:'Siga para mais',headlineHtml:''};
}

function isLight(bg){
  if(bg==='white')return true;if(bg==='dark')return false;
  const c=(bg||'').replace('#','');if(c.length<6)return false;
  const r=parseInt(c.slice(0,2),16),g=parseInt(c.slice(2,4),16),b=parseInt(c.slice(4,6),16);
  return(0.299*r+0.587*g+0.114*b)>160;
}

/* ── Panel open/close ── */
function openPanel(name){
  const same=currentPanel===name;
  document.querySelectorAll('.rail-btn').forEach(b=>b.classList.remove('on'));
  if(same){document.getElementById('sidebar').classList.remove('open');currentPanel=null;return;}
  document.getElementById('sidebar').classList.add('open');
  document.getElementById(`rail-${name}`).classList.add('on');
  document.getElementById('sb-title').textContent=PANELS[name].title;
  document.getElementById('sb-sub').textContent=PANELS[name].sub;
  renderPanel(name);
  currentPanel=name;
}

function renderPanel(name){
  const body=document.getElementById('sb-body');
  if(name==='ia') body.innerHTML=renderPanelIA();
  else if(name==='slides') body.innerHTML=renderPanelSlides();
  else if(name==='typo') body.innerHTML=renderPanelTypo();
  else if(name==='profile') body.innerHTML=renderPanelProfile();
  else if(name==='export') body.innerHTML=renderPanelExport();
}

/* ── Panel: IA ── */
function renderPanelIA(){
  return`
  <div style="margin-bottom:14px">
    <span class="flbl">Assunto do carrossel</span>
    <textarea id="topic" class="field" rows="4" placeholder="Ex: Os maiores erros que negócios locais cometem ao não anunciar">${window._topic||''}</textarea>
  </div>
  <div style="margin-bottom:16px">
    <span class="flbl">Tom do conteúdo</span>
    <div style="display:flex;flex-wrap:wrap;gap:6px" id="tones-wrap">
      ${TONES.map(t=>`<button class="pill ${selTone===t?'on':''}" onclick="selTone=selTone==='${t}'?'':('${t}');renderPanel('ia')" >${t}</button>`).join('')}
    </div>
  </div>
  <div style="margin-bottom:14px">
    <span class="flbl">Quantidade de slides</span>
    <div style="display:flex;gap:4px;flex-wrap:wrap">
      ${Array.from({length:9},(_,i)=>i+2).map(n=>`<button class="cnt-btn ${slideCount===n?'on':''}" onclick="slideCount=${n};renderPanel('ia')">${n}</button>`).join('')}
    </div>
  </div>
  <button class="btn-main" id="gen-btn" onclick="generate()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    Gerar Carrossel Turb
  </button>
  <div id="gen-error" style="display:none;margin-top:10px;padding:10px 12px;background:#2a1a1a;border:1px solid #E24B2B;border-radius:9px;color:#F4846F;font-size:11px"></div>
  `;
}

/* ── Panel: Slides ── */
function renderPanelSlides(){
  const s=slides[pvIdx];
  const isCover=pvIdx===0,isLast=pvIdx===slideCount-1;
  return`
  <div style="margin-bottom:12px">
    <span class="flbl">Slide ativo</span>
    <div style="display:flex;gap:5px;flex-wrap:wrap">
      ${slides.slice(0,slideCount).map((sl,i)=>`<button class="slide-tab ${pvIdx===i?'on':''}" onclick="pvGoTo(${i});renderPanel('slides')">
        ${i===0?'Capa':i===slideCount-1?'CTA':i+1} ${sl.aiGenerated?'<span class="ai-badge">IA</span>':''}
      </button>`).join('')}
    </div>
  </div>

  <div class="sb-section">
    <div class="sb-section-hd" onclick="toggleSection(this)">
      <span class="sb-section-lbl">Fundo</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    </div>
    <div class="sb-section-body">
      <div style="display:flex;gap:5px;align-items:center;flex-wrap:wrap;margin-bottom:10px">
        <button onclick="updSlide(${pvIdx},'bg','dark')" style="padding:5px 11px;border-radius:7px;font-size:11px;font-weight:600;cursor:pointer;background:#000000;color:#F4F6FC;border:${(s.bg||'dark')==='dark'?'2px solid #FF6229':'2px solid transparent'};font-family:inherit">Escuro</button>
        <button onclick="updSlide(${pvIdx},'bg','white')" style="padding:5px 11px;border-radius:7px;font-size:11px;font-weight:600;cursor:pointer;background:#FFFFFF;color:#000000;border:${s.bg==='white'?'2px solid #FF6229':'2px solid transparent'};font-family:inherit">Branco</button>
        <button onclick="document.getElementById('bgc').click()" style="width:28px;height:28px;border-radius:7px;border:1px solid #252540;background:${!['dark','white'].includes(s.bg||'dark')?s.bg:'linear-gradient(135deg,#FF6229,#FFCC47)'};cursor:pointer" title="Cor personalizada"></button>
        <input id="bgc" type="color" value="${!['dark','white'].includes(s.bg||'dark')?s.bg:'#FF6229'}" onchange="updSlide(${pvIdx},'bg',this.value)" style="display:none">
      </div>
      ${isCover?`
      <div style="margin-top:8px">
        <span class="flbl" style="margin-bottom:6px">Cor da capa</span>
        <div style="display:flex;gap:5px;flex-wrap:wrap;align-items:center">
          <button onclick="document.getElementById('bgc2').click()" style="width:28px;height:28px;border-radius:7px;border:2px solid #FF6229;background:${!['dark','white'].includes(s.bg||'dark')?s.bg:'#000000'};cursor:pointer" title="Escolher cor"></button>
          <input id="bgc2" type="color" value="${!['dark','white'].includes(s.bg||'dark')?s.bg:'#000000'}" onchange="updSlide(${pvIdx},'bg',this.value);renderPanel('slides')" style="display:none">
          ${['#000000','#1a0000','#001a00','#00001a','#1a1a00','#1a001a','#001a1a','#2a0a00','#0a002a','#ffffff','#111111','#222222'].map(c=>`<button onclick="updSlide(${pvIdx},'bg','${c}');renderPanel('slides')" style="width:18px;height:18px;border-radius:4px;background:${c};border:${(s.bg||'dark')===c||(!['dark','white'].includes(s.bg||'dark')&&s.bg===c)?'2px solid #FF6229':'1px solid #333'};cursor:pointer"></button>`).join('')}
        </div>
      </div>`:''}
    </div>
  </div>

  <div class="sb-section">
    <div class="sb-section-hd" onclick="toggleSection(this)">
      <span class="sb-section-lbl">Headline</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    </div>
    <div class="sb-section-body">
      <div style="margin-bottom:8px">
        <span class="flbl">Texto <span style="color:#444;font-weight:400">— selecione para destacar</span></span>
        <div style="position:relative" id="hl-wrap-${pvIdx}">
