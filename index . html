/* ── Helpers ── */
function toggleSection(hd){
  const body=hd.nextElementSibling;
  const isHidden=body.classList.contains('hidden');
  body.classList.toggle('hidden',!isHidden);
  hd.querySelector('svg').style.transform=isHidden?'rotate(0)':'rotate(-90deg)';
}

function updSlide(i,k,v){
  slides[i][k]=v;
  if(k==='hY'){const el=document.getElementById('hy-lbl');if(el)el.textContent=v+'px';}
  updPvSlide(i);
  if(['bg','image','imgOpacity','imgX','imgY'].includes(k)) renderPanel(currentPanel);
  else if(['hFont','bFont','hSize','bSize','hAlign','bAlign','hColor','bColor'].includes(k)) updPvSlide(i);
}

function applyGlobal(){
  const hf=document.getElementById('g-hfont').value;
  const bf=document.getElementById('g-bfont').value;
  slides.forEach(s=>{s.hFont=hf;s.bFont=bf;});
  renderPreview();
}

function setImg(i,inp){
  const f=inp.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{slides[i].image=ev.target.result;renderPanel(currentPanel);updPvSlide(i);};
  r.readAsDataURL(f);
}

function setAvatar(inp){
  const f=inp.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{profileData.avatar=ev.target.result;renderPanel('profile');renderPreview();};
  r.readAsDataURL(f);
}

/* ── Slide HTML ── */
function slideHTML(s,i,total){
  const isCover=i===0,isLast=i===total-1;
  const handle=`@${profileData.username||'seu.usuario'}`;
  const hf=s.hFont||'Sora',bf=s.bFont||'Inter';
  const hs=s.hSize||(isCover?30:isLast?26:22);
  const bs=s.bSize||13;
  const ha=s.hAlign||'center',ba=s.bAlign||'left';
  const hc=s.hColor||'#F4F6FC';
  const bc=s.bColor||'rgba(244,246,252,0.7)';
  const bg=s.bg||'dark';
  const light=isLight(bg);
  const bgColor=bg==='white'?'#FFFFFF':(bg==='dark'?'#000000':bg);
  const justMap={left:'flex-start',center:'center',right:'flex-end'};
  const acColor=bc.startsWith('rgba')?'rgba(244,246,252,0.7)':bc;
  const av=profileData.avatar
    ?`<img src="${profileData.avatar}" style="width:${isCover?22:18}px;height:${isCover?22:18}px;border-radius:50%;object-fit:cover;border:1.5px solid ${acColor};flex-shrink:0">`
    :`<div style="width:${isCover?22:18}px;height:${isCover?22:18}px;border-radius:50%;background:${acColor}22;border:1.5px solid ${acColor};display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="${acColor}" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>`;

  if(isCover)return`<div class="insta" style="background:${bgColor}">
    ${s.image?`<img src="${s.image}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:${s.imgX??50}% ${s.imgY??50}%;opacity:${(s.imgOpacity??35)/100}">`:''}
    ${!s.image&&!light?'<div style="position:absolute;inset:0;background:linear-gradient(145deg,#000000,#12122a)"></div>':''}
    ${!light?`<div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(15,12,30,0.9) 0%,rgba(15,12,30,0.2) 60%,transparent 100%)"></div>`:''}
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:${bgColor}"></div>
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:${justMap[ha]};padding:32px 26px 68px">
      <p style="font-family:'${hf}',system-ui;font-weight:900;font-size:${hs}px;color:${hc};text-align:${ha};line-height:1.35;margin:0;transform:translateY(${s.hY||0}px);word-break:break-word">${s.headlineHtml||s.headline||'Headline principal aqui'}</p>
    </div>
    <div style="position:absolute;top:13px;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:7px">${av}<span style="font-size:11px;color:${acColor};font-weight:600">${handle}</span></div>
    <div style="position:absolute;bottom:16px;right:16px;display:flex;align-items:center;gap:4px;opacity:.5">
      <span style="font-size:9px;color:${light?'#333':'#fff'};font-weight:500">arraste</span>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="${light?'#333':'#fff'}" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>
  </div>`;

  return`<div class="insta" style="background:${bgColor}">
    <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:${bgColor}"></div>
    <div style="position:absolute;top:14px;right:14px;font-size:9px;color:${light?'rgba(0,0,0,0.25)':'rgba(244,246,252,0.25)'};font-weight:600;letter-spacing:.08em">${i+1}/${total}</div>
    <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:44px 22px 20px 26px">
      ${s.image?`<div style="margin-bottom:12px;border-radius:9px;overflow:hidden;height:120px;flex-shrink:0"><img src="${s.image}" style="width:100%;height:100%;object-fit:cover;object-position:${s.imgX??50}% ${s.imgY??50}%;opacity:${(s.imgOpacity??100)/100}"></div>`:''}
      <p style="font-family:'${hf}',system-ui;font-weight:800;font-size:${hs}px;color:${hc};line-height:1.3;margin-bottom:${s.body?11:0}px;text-align:${ha};transform:translateY(${s.hY||0}px);word-break:break-word">${s.headlineHtml||s.headline||'Headline aqui'}</p>
      ${s.body?`<p style="font-family:'${bf}',system-ui;font-size:${bs}px;color:${bc};line-height:1.65;text-align:${ba};transform:translateY(${s.bY||0}px);word-break:break-word">${s.body}</p>`:''}
      ${isLast?`<div style="margin-top:14px;display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:100px;background:${acColor}18;border:1px solid ${acColor}55;align-self:${ha==='center'?'center':ha==='right'?'flex-end':'flex-start'}"><span style="font-size:11px;color:${acColor};font-weight:600">${s.cta||'Siga para mais'}</span></div>`:''}
    </div>
    <div style="position:absolute;top:11px;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:6px">${av}<span style="font-size:9px;color:${acColor};font-weight:600">${handle}</span></div>
  </div>`;
}

/* ── Preview ── */
function renderPreview(){
  const empty=document.getElementById('empty-state');
  const nav=document.getElementById('pv-nav');
  const track=document.getElementById('pv-track');
  const dots=document.getElementById('pv-dots');
  const counter=document.getElementById('pv-counter');
  const prev=document.getElementById('pv-prev');
  const next=document.getElementById('pv-next');
  if(empty){empty.style.display='none';}
  if(nav){nav.style.display='flex';}
  track.innerHTML=slides.slice(0,slideCount).map((s,i)=>`
    <div class="sw ${i!==pvIdx?'dim':''}" id="pv-sw-${i}" onclick="pvGoTo(${i})" style="cursor:${i!==pvIdx?'pointer':'default'}">
      ${slideHTML(s,i,slideCount)}
    </div>`).join('');
  dots.innerHTML=slides.slice(0,slideCount).map((_,i)=>`<button onclick="pvGoTo(${i})" style="height:5px;width:${i===pvIdx?16:5}px;border-radius:3px;background:${i===pvIdx?'#FF6229':'#1e1e30'};border:none;cursor:pointer;transition:all .2s;font-family:inherit"></button>`).join('');
  if(counter)counter.textContent=`${pvIdx+1} / ${slideCount}`;
  if(prev)prev.style.opacity=pvIdx===0?.25:1;
  if(next)next.style.opacity=pvIdx===slideCount-1?.25:1;
}

function updPvSlide(i){
  const el=document.getElementById(`pv-sw-${i}`);
  if(!el)return;
  el.innerHTML=slideHTML(slides[i],i,slideCount);
  el.className=`sw ${i!==pvIdx?'dim':''}`;
  el.style.cursor=i!==pvIdx?'pointer':'default';
}

function pvGoTo(i){
  if(i<0||i>=slideCount)return;
  pvIdx=i;
  renderPreview();
  if(currentPanel==='slides'||currentPanel==='typo') renderPanel(currentPanel);
  const track=document.getElementById('pv-track');
  const el=document.getElementById(`pv-sw-${i}`);
  if(track&&el){const off=el.offsetLeft-(track.clientWidth-el.offsetWidth)/2;track.scrollTo({left:off,behavior:'smooth'});}
}
function pvNav(d){pvGoTo(pvIdx+d);}

/* ── Download ── */
async function dlOne(idx){
  const tmp=document.createElement('div');
  tmp.style.cssText='position:fixed;left:-9999px;top:0;z-index:-1';
  tmp.innerHTML=slideHTML(slides[idx],idx,slideCount);
  document.body.appendChild(tmp);
  await new Promise(r=>setTimeout(r,120));
  try{
    const c=await html2canvas(tmp.firstElementChild,{scale:2.5,useCORS:true,allowTaint:true,logging:false});
    await new Promise(resolve=>{
      c.toBlob(blob=>{
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');
        a.href=url;
        a.download=`turb-slide-${idx+1}.png`;
        a.style.display='none';
        document.body.appendChild(a);
        a.click();
        setTimeout(()=>{URL.revokeObjectURL(url);document.body.removeChild(a);resolve();},200);
      },'image/png');
    });
  }catch(e){alert('Erro ao exportar: '+e.message);}
  document.body.removeChild(tmp);
}

async function dlAll(){
  const btn=document.getElementById('topbar-dl');
  const expBar=document.getElementById('exp-bar');
  const expProg=document.getElementById('exp-progress');
  if(btn)btn.disabled=true;
  if(expProg)expProg.style.display='block';
  const zip=new JSZip();
  for(let i=0;i<slideCount;i++){
    const tmp=document.createElement('div');
    tmp.style.cssText='position:fixed;left:-9999px;top:0;z-index:-1';
    tmp.innerHTML=slideHTML(slides[i],i,slideCount);
    document.body.appendChild(tmp);
    await new Promise(r=>setTimeout(r,120));
    try{const c=await html2canvas(tmp.firstElementChild,{scale:2.5,useCORS:true,allowTaint:true,logging:false});const blob=await new Promise(r=>c.toBlob(r,'image/png'));zip.file(`slide-${String(i+1).padStart(2,'0')}.png`,blob);}catch(e){}
    document.body.removeChild(tmp);
    const pct=Math.round(((i+1)/slideCount)*100);
    if(expBar)expBar.style.width=pct+'%';
    const pvBar=document.getElementById('pv-bar');if(pvBar)pvBar.style.width=pct+'%';
  }
  const content=await zip.generateAsync({type:'blob'});
  const a=document.createElement('a');a.download=`carrossel-${Date.now()}.zip`;a.href=URL.createObjectURL(content);a.click();
  if(btn)btn.disabled=false;
  if(expProg)expProg.style.display='none';
  if(expBar)expBar.style.width='0%';
}

/* ── Highlight functions ── */
function checkHlSelection(i){
  const sel=window.getSelection();
  const toolbar=document.getElementById('hl-toolbar');
  if(!toolbar)return;
  if(!sel||sel.isCollapsed||!sel.toString().trim()){
    toolbar.style.display='none';return;
  }
  const inp=document.getElementById('hl-inp');
  if(!inp||!inp.contains(sel.anchorNode)){toolbar.style.display='none';return;}
  const range=sel.getRangeAt(0);
  const rect=range.getBoundingClientRect();
  const wrap=document.getElementById(`hl-wrap-${i}`);
  const wRect=wrap?wrap.getBoundingClientRect():{top:0,left:0};
  toolbar.style.display='flex';
  toolbar.style.top=(rect.top-wRect.top-48)+'px';
  toolbar.style.left=Math.max(0,rect.left-wRect.left)+'px';
}

function hideHlToolbar(){
  const t=document.getElementById('hl-toolbar');
  if(t)t.style.display='none';
}

function applyHighlight(color){
  const inp=document.getElementById('hl-inp');
  if(!inp)return;
  inp.focus();
  document.execCommand('styleWithCSS',false,true);
  if(color==='transparent'){
    document.execCommand('removeFormat',false,null);
  } else {
    document.execCommand('hiliteColor',false,color);
    // also ensure text color contrasts
    const isLight=c=>{if(!c||c==='transparent')return false;const r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);return(0.299*r+0.587*g+0.114*b)>160;};
    document.execCommand('foreColor',false,isLight(color)?'#000000':'#ffffff');
  }
  const i=parseInt(inp.dataset.slide||'0');
  slides[i].headlineHtml=inp.innerHTML;
  slides[i].headline=inp.innerText;
  updPvSlide(i);
  hideHlToolbar();
  window.getSelection()?.removeAllRanges();
}

function syncHl(i){
  const inp=document.getElementById('hl-inp');
  if(!inp)return;
  slides[i].headlineHtml=inp.innerHTML;
  slides[i].headline=inp.innerText.trim();
  updPvSlide(i);
}

/* ── AI Generate ── */
async function generate(){
  const topic=document.getElementById('topic')?.value.trim();
  window._topic=topic;
  const errDiv=document.getElementById('gen-error');
  if(errDiv)errDiv.style.display='none';
  if(!topic||!selTone)return;
  const btn=document.getElementById('gen-btn');
  if(!btn)return;
  btn.disabled=true;
  let li=0;
  loadTimer=setInterval(()=>{li=(li+1)%LOADING.length;if(btn)btn.innerHTML=`<span class="spin">⟳</span> ${LOADING[li]}`;},1600);
  btn.innerHTML=`<span class="spin">⟳</span> ${LOADING[0]}`;

  const prompt=`Você é um copywriter especialista no estilo litecopy: direto, conversacional, magnético, sem clichê corporativo. Escreva em português brasileiro informal.\n\nASSUNTO: "${topic}"\nQUANTIDADE DE SLIDES: ${slideCount}\nTOM: ${selTone}\n\nGere exatamente ${slideCount} slides. Retorne APENAS JSON válido, sem markdown, sem explicação.\n\nREGRAS:\n- Slide 1 (capa): headline gancho impactante com máx 15 palavras, body vazio\n- Slides intermediários: headline com máx 10 palavras, body com 2 a 3 frases curtas e diretas\n- Último slide: headline de fechamento com CTA natural, body opcional\n- Proibido bullet points, listas, hifens, traços\n- Tom: ${selTone}\n\nFORMATO EXATO:\n{"slides":[{"headline":"...","body":"..."}]}`;

  try{
    const GEMINI_KEY='AIzaSyC5iJ5SiCsIEc8ZSxYWvgg65AW4OSW_gYg';
    const res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_KEY}`,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.7,maxOutputTokens:1000}})
    });
    const data=await res.json();
    if(data.error)throw new Error(data.error?.message||'Erro da API Gemini');
    const raw=data.candidates?.[0]?.content?.parts?.[0]?.text||'';
    if(!raw)throw new Error('Resposta vazia da IA');
    const match=raw.match(/\{[\s\S]*\}/);
    if(!match)throw new Error('Formato inválido: '+raw.slice(0,100));
    const parsed=JSON.parse(match[0]);
    if(!parsed.slides||!Array.isArray(parsed.slides))throw new Error('JSON sem slides');
    parsed.slides.forEach((s,i)=>{slides[i]={...slides[i],headline:s.headline||'',headlineHtml:s.headline||'',body:s.body||'',aiGenerated:true};});
    renderPreview();
    openPanel('slides');
  }catch(e){
    console.error(e);
    const ed=document.getElementById('gen-error');
    if(ed){ed.textContent='Erro: '+e.message;ed.style.display='block';}
  }finally{
    clearInterval(loadTimer);
    if(btn){btn.disabled=false;btn.innerHTML='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Gerar Carrossel Turb';}
  }
}

